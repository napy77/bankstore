{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"],
  // El seed importa el catálogo del frontend (../../src/data), que queda fuera
  // de rootDir y rompería el build. No hace falta compilarlo: es una tarea de
  // operación que se corre con tsx. Se typechequea con tsconfig.seed.json.
  "exclude": ["src/seed.ts", "src/seed-marketplace.ts"]
}
