{
  "name": "bankstore",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:tienda": "npm run dev --workspace @bankstore/tienda",
    "dev:comercios": "npm run dev --workspace @bankstore/comercios",
    "dev:admin": "npm run dev --workspace @bankstore/admin",
    "dev:api": "npm run dev --workspace bankstore-backend",
    "build": "npm run build --workspace @bankstore/tienda && npm run build --workspace @bankstore/comercios && npm run build --workspace @bankstore/admin",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspace bankstore-backend"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
