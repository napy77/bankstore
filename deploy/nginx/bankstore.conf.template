# ─────────────────────────────────────────────────────────────────────────────
# Bankstore — tres subdominios, un solo backend
#
#   __STORE_DOMAIN__     tienda pública          → apps/tienda/dist
#   __MERCHANT_DOMAIN__  panel de comercios      → apps/comercios/dist
#   __ADMIN_DOMAIN__     administración          → apps/admin/dist   (INTRANET)
#
# Los tres proxean /api al mismo proceso en 127.0.0.1:__API_PORT__, pero cada
# uno expone SÓLO las rutas que le corresponden.
#
# Esto último es la parte importante. El backend ya rechaza a quien no tiene el
# rol, pero si los tres subdominios proxearan /api entero, /api/admin quedaría
# alcanzable desde la tienda pública y la restricción de intranet no serviría
# de nada: bastaría con robar un token de administrador desde afuera. Al cortar
# en Nginx, un token filtrado tampoco alcanza — hay que estar en la red.
#
# Este archivo lo genera setup-server.sh desde la plantilla. Después certbot le
# agrega los bloques 443 y a partir de ahí NO se regenera solo.
# ─────────────────────────────────────────────────────────────────────────────

# Cabeceras del proxy. Se repiten en los tres bloques; va en un include para
# no mantener tres copias que se desincronizan.
# (se escribe en /etc/nginx/snippets/bankstore-proxy.conf)

# ── Tienda pública ───────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __STORE_DOMAIN__;

    root __APP_DIR__/apps/tienda/dist;

    # Los assets llevan hash en el nombre: si cambia el contenido cambia el
    # nombre, así que se pueden cachear para siempre.
    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Sólo lo que necesita un comprador. /api/admin y /api/merchant no existen
    # desde acá.
    location ~ ^/api/(auth|catalog|cards|orders|addresses)(/|$) {
        include snippets/bankstore-proxy.conf;
    }

    # Cualquier otra ruta de /api no existe en este subdominio. Sin esto caería
    # en el `location /` de abajo y devolvería el HTML del SPA con un 200, que
    # es lo peor de los dos mundos: no funciona y encima no lo parece.
    #
    # Nginx evalúa los regex ANTES de usar el prefijo más largo, así que este
    # bloque sólo entra en juego cuando ninguna de las rutas permitidas matcheó.
    location /api/ {
        return 404 '{"error":"Ese endpoint no está disponible en este dominio"}';
        default_type application/json;
    }

    location = /health {
        proxy_pass http://127.0.0.1:__API_PORT__/health;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
        location = /index.html {
            add_header Cache-Control "no-cache, must-revalidate";
        }
    }

    include snippets/bankstore-security.conf;
    client_max_body_size 2m;
}

# ── Panel de comercios ───────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __MERCHANT_DOMAIN__;

    root __APP_DIR__/apps/comercios/dist;

    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Login de back-office, panel del comercio y la API de integración que
    # consumen sus ERPs. Nada de /api/admin.
    location ~ ^/api/(staff|merchant|v1)(/|$) {
        include snippets/bankstore-proxy.conf;
    }

    # Cualquier otra ruta de /api no existe en este subdominio. Sin esto caería
    # en el `location /` de abajo y devolvería el HTML del SPA con un 200, que
    # es lo peor de los dos mundos: no funciona y encima no lo parece.
    #
    # Nginx evalúa los regex ANTES de usar el prefijo más largo, así que este
    # bloque sólo entra en juego cuando ninguna de las rutas permitidas matcheó.
    location /api/ {
        return 404 '{"error":"Ese endpoint no está disponible en este dominio"}';
        default_type application/json;
    }

    location = /health {
        proxy_pass http://127.0.0.1:__API_PORT__/health;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
        location = /index.html {
            add_header Cache-Control "no-cache, must-revalidate";
        }
    }

    include snippets/bankstore-security.conf;
    # Los lotes de catálogo son de hasta 500 productos.
    client_max_body_size 4m;
}

# ── Administración — sólo intranet ───────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __ADMIN_DOMAIN__;

    root __APP_DIR__/apps/admin/dist;

    # Let's Encrypt valida por HTTP desde internet, así que el challenge tiene
    # que quedar abierto aunque el resto del sitio no lo esté. Va primero para
    # ganarle a las reglas de abajo.
    location ^~ /.well-known/acme-challenge/ {
        allow all;
        root /var/www/html;
    }

    # A partir de acá, sólo la intranet. setup-server.sh escribe las redes
    # permitidas en este snippet a partir de ADMIN_ALLOWED_CIDRS.
    include snippets/bankstore-admin-allow.conf;

    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # El único lugar del mundo desde donde se llega a /api/admin.
    location ~ ^/api/(staff|admin|catalog)(/|$) {
        include snippets/bankstore-proxy.conf;
    }

    # Cualquier otra ruta de /api no existe en este subdominio. Sin esto caería
    # en el `location /` de abajo y devolvería el HTML del SPA con un 200, que
    # es lo peor de los dos mundos: no funciona y encima no lo parece.
    #
    # Nginx evalúa los regex ANTES de usar el prefijo más largo, así que este
    # bloque sólo entra en juego cuando ninguna de las rutas permitidas matcheó.
    location /api/ {
        return 404 '{"error":"Ese endpoint no está disponible en este dominio"}';
        default_type application/json;
    }

    location / {
        try_files $uri $uri/ /index.html;
        location = /index.html {
            add_header Cache-Control "no-cache, must-revalidate";
        }
    }

    include snippets/bankstore-security.conf;
    # Que no aparezca en buscadores aunque alguien lo exponga por error.
    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 2m;
}
