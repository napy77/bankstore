# ─────────────────────────────────────────────────────────────────────────────
# Configuración del despliegue de Bankstore
#
# Copiar a /etc/bankstore-deploy.env en el servidor y completar.
# Lo leen setup-server.sh, deploy.sh y smoke-test.sh.
#
#   sudo cp /opt/bankstore/deploy/bankstore.env.example /etc/bankstore-deploy.env
#   sudo chmod 600 /etc/bankstore-deploy.env
#   sudo nano /etc/bankstore-deploy.env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Dominio ─────────────────────────────────────────────────────────────────
# Un solo dominio sirve todo: / son los estáticos del frontend y /api va al
# backend. Así hay un solo certificado y el navegador nunca hace cross-origin.
# Tiene que apuntar (registro A) a la IP de este servidor ANTES de pedir el
# certificado.
DOMAIN=bankstore.nexopos.app

# Email para los avisos de vencimiento de Let's Encrypt
CERTBOT_EMAIL=germanyovan@gmail.com

# ─── Rutas y repositorio ─────────────────────────────────────────────────────
# Carpeta propia: NO puede ser la de NexoPOS ni la de ClubPay.
APP_DIR=/opt/bankstore

# HTTPS con token es lo más simple en un servidor: no hay que instalar una
# clave de despliegue. Si el repo es privado, generá un token de solo lectura
# en GitHub y usá:
#   https://<token>@github.com/napy77/bankstore.git
# Con SSH (git@github.com:napy77/bankstore.git) hay que dejarle una deploy key
# al usuario bankstore en ~/.ssh, que es un paso más.
REPO_URL=https://github.com/napy77/bankstore.git
BRANCH=main

# Usuario del sistema que corre el servicio y es dueño de la carpeta
APP_USER=bankstore

# ─── Puerto interno ──────────────────────────────────────────────────────────
# El backend se ata a 127.0.0.1: sólo se llega por Nginx.
#
# OJO: no puede coincidir con los de los otros proyectos de esta VM.
#   NexoPOS  → 4000 (API) y 3000 (front)
#   ClubPay  → 4010 (API) y 3110 (panel)
#   Bankstore→ 4020 (API) y nada de front: es estático, lo sirve Nginx
# setup-server.sh frena si está ocupado. Para ver qué hay tomado: sudo ss -ltnp
API_PORT=4020

# ─── Base de datos ───────────────────────────────────────────────────────────
# Base y usuario propios, separados de los de NexoPOS y ClubPay.
DB_NAME=bankstore
DB_USER=bankstore
DB_HOST=localhost
DB_PORT=5432
# Dejar vacío y setup-server.sh genera una al azar, que queda escrita en el
# .env del backend.
DB_PASSWORD=

# ─── Parámetros financieros ──────────────────────────────────────────────────
# TNA que se aplica cuando el cliente pide más cuotas de las que el banco
# banca sin interés. Como fracción: 0.42 = 42% anual.
TNA_DEFAULT=0.42
# IVA sobre los intereses de financiación. Entra en el CFT que se informa.
IVA_INTERESES=0.21

# ─── Datos de prueba ─────────────────────────────────────────────────────────
# Si es "true", después de migrar se cargan los bancos, productos y el usuario
# demo del prototipo. Para un entorno de prueba está bien; en producción de
# verdad hay que ponerlo en false y cargar el catálogo real.
SEED_DEMO_DATA=true
SEED_EMAIL=demo@bankstore.test
# Cambiala si vas a dejar la demo accesible desde internet.
SEED_PASSWORD=bankstore2026

# ─── Back-office ─────────────────────────────────────────────────────────────
# Administrador de la plataforma: da de alta comercios, fija comisiones y
# carga los acuerdos bancarios. Se crea con el seed de comercios.
#
# CAMBIÁ ESTA CONTRASEÑA antes de exponer el sitio: con esta cuenta se puede
# dar de alta cualquier comercio y cualquier promoción.
ADMIN_EMAIL=admin@bankstore.test
ADMIN_PASSWORD=bankstore-admin-2026

# Contraseña con la que se crean los usuarios admin de cada comercio de
# ejemplo (admin@electro-1.test, admin@hotel-2.test, …).
MERCHANT_PASSWORD=comercio-2026-demo
